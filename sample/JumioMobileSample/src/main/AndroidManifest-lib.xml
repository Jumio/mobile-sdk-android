<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">

	<application>

		<!-- KOTLIN -->
		<activity
			android:name="com.jumio.sample.MainActivity"
			android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|layoutDirection"
			android:exported="true"
			android:screenOrientation="portrait"
			android:theme="@style/AppTheme">
		</activity>
		<activity
			android:name="com.jumio.sample.compose.activities.MainActivity"
			android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|layoutDirection"
			android:exported="true"
			android:screenOrientation="portrait"
			android:theme="@style/AppTheme" />
		<activity
			android:name="com.jumio.sample.compose.activities.CustomUIActivity"
			android:exported="true"
			android:screenOrientation="portrait"
			android:launchMode="singleTask"
			android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|layoutDirection"
			android:theme="@style/AppTheme"
			android:label="Jumio Sample Compose Custom UI">
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />

				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />

				<data
					android:host="jumio-di-redirect"
					android:scheme="app" />
			</intent-filter>
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />

				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />

				<data
					android:host="jumio-digital-identity"
					android:scheme="eidas" />
			</intent-filter>
		</activity>

		<activity
			android:name="com.jumio.sample.xml.MainActivity"
			android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|layoutDirection"
			android:exported="true"
			android:screenOrientation="portrait"
			android:theme="@style/AppTheme" />
		<activity
			android:name="com.jumio.sample.xml.CustomUiActivity"
			android:exported="true"
			android:screenOrientation="portrait"
			android:launchMode="singleTask"
			android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|layoutDirection"
			android:theme="@style/Theme.Jumio"
			android:label="Jumio Sample XML Custom UI">
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />

				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />

				<data
					android:host="jumio-di-redirect"
					android:scheme="app" />
			</intent-filter>
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />

				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />

				<data
					android:host="jumio-digital-identity"
					android:scheme="eidas" />
			</intent-filter>
		</activity>

		<activity
			android:name="com.jumio.defaultui.JumioActivity"
			android:exported="true"
			android:screenOrientation="portrait"
			android:launchMode="singleTask"
			tools:replace="android:exported">
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />

				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />

				<data
					android:host="jumio-di-redirect"
					android:scheme="app" />
			</intent-filter>
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />

				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />

				<data
					android:host="jumio-digital-identity"
					android:scheme="eidas" />
			</intent-filter>
		</activity>

	</application>

</manifest>